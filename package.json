{
  "name": "campuspulse",
  "version": "1.5.1",
  "private": true,
  "description": "A lightweight course enrollment, attendance, and quiz prototype for classrooms.",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/package-sites.mjs",
    "start": "node server.js",
    "android:sync": "cap sync android",
    "android:build": "cap sync android && cd android && gradlew.bat assembleDebug",
    "android:release": "cap sync android && cd android && gradlew.bat assembleRelease",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capgo/capacitor-updater": "^8.51.3",
    "@mdx-js/rollup": "^3.1.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitejs/plugin-rsc": "^0.5.26",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.2.6",
    "vinext": "1.0.0-beta.4",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2"
  }
}
