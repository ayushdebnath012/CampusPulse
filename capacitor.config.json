{
  "appId": "in.campuspulse.app",
  "appName": "CampusPulse",
  "webDir": "public",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "scheme": "CampusPulse"
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": "off",
      "appReadyTimeout": 10000,
      "keepUrlPathAfterReload": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_campuspulse",
      "iconColor": "#5B5BD6"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
