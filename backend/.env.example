PORT=8787
DATABASE_PATH=./data/campuspulse.json
TARGET_DATABASE_URL=
DATABASE_SSL=false
DATABASE_CACHE_TTL_MS=10000
ALLOWED_ORIGINS=https://ayushdebnath012.github.io,https://localhost,capacitor://localhost,http://localhost,http://127.0.0.1:4173
ALLOW_DEV_VERIFICATION_CODE=true

# Email delivery, in the order the server prefers it.
# Brevo verifies a single sender address, so it reaches any recipient without
# owning a domain. Resend needs a verified domain before it will do the same.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=CampusPulse <noreply@example.com>

# Alternative SMTP delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Courses, roll lists and join codes are created by professors in the app.
